% title "New plugin";
% layout 'default';

% content_for 'sidebar' => begin
  %= include 'partial/side_menu'
% end

% content_for 'head' => begin
  <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet" integrity="sha384-piG3EtH1fBnPi68q4spy+Qgpb0dHK1D1dwk0GaHwFkvmUxYi526bBlk3xJcjEBsD" crossorigin="anonymous">
% end

<h2><%= title %></h2>

<p>
%= form_for 'new-plugin' => (method => 'POST', id => 'new_plugin_form') => begin
  <div class="mb-3">
    % if (@$repos) {
    <select required class="form-select" name="plugin_repo" id="plugin_repo" aria-describedby="repoHelp">
      <option value="" disabled selected>Choose a repository&hellip;</option>
      % for my $repo (@$repos) {
      <option value="<%= $repo->{html_url} %>"><%= $repo->{full_name} %></option>
      % }
    </select>
    <div id="repoHelp" class="form-text">
      Search across all of your public GitHub repositories, including organizations you belong
      to. Repo list last refreshed <%= $repos_fetched_at %>.
    </div>
    % } else {
    <p class="text-danger">No public GitHub repositories found for your account. Make sure your plugin's repository is public, then click Refresh below.</p>
    % }
  </div>
  <div class="mb-3">
    <input required type="checkbox" class="form-check-input" name="author_confirm" id="author_confirm">
    <label class="form-check-label" for="author_confirm">I am the author of this plugin
  </div>
  <div class="mb-3">
    <input required type="checkbox" class="form-check-input" name="author_confirm" id="tos">
    <label class="form-check-label" for="tos">I agree to the <a href="#">terms of service</a></label>
  </div>
  <button type="submit" class="btn btn-primary">Submit</button>
% end
</p>

%= form_for '/developer/repos/refresh' => (method => 'POST') => begin
  <button type="submit" class="btn btn-outline-secondary btn-sm">
    <i class='bx bx-refresh'></i> Refresh my GitHub repos
  </button>
% end

% content_for 'end' => begin
  <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js" integrity="sha384-cnROoUgVILyibe3J0zhzWoJ9p2WmdnK7j/BOTSWqVDbC1pVw2d+i6Q/1ESKJKCYf" crossorigin="anonymous"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var select = document.getElementById('plugin_repo');
      if (select) {
        new TomSelect(select, { create: false });
      }
    });
  </script>
% end
