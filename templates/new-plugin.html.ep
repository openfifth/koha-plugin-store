% title "New plugin";
% layout 'default';

% content_for 'sidebar' => begin
  %= include 'partial/side_menu'
% end

<h2><%= title %></h2>

<p>
%= form_for 'new-plugin' => (method => 'POST', id => 'new_plugin_form') => begin
  <div class="mb-3">
    % if (@$repos) {
    <select required class="form-select" name="plugin_repo" id="plugin_repo" aria-describedby="repoHelp">
      <option value="" disabled selected>Choose a repository&hellip;</option>
      % for my $repo (@$repos) {
      <option value="<%= $repo->{html_url} %>"><%= $repo->{full_name} %></option>
      % }
    </select>
    <div id="repoHelp" class="form-text">Only your public <i class='bx bxl-github'></i> GitHub repositories are listed here.</div>
    % } else {
    <p class="text-danger">No public GitHub repositories found for your account. Make sure your plugin's repository is public, then refresh this page.</p>
    % }
  </div>
  <div class="mb-3">
    <input required type="checkbox" class="form-check-input" name="author_confirm" id="author_confirm">
    <label class="form-check-label" for="author_confirm">I am the author of this plugin
  </div>
  <div class="mb-3">
    <input required type="checkbox" class="form-check-input" name="author_confirm" id="tos">
    <label class="form-check-label" for="tos">I agree to the <a href="#">terms of service</a></label>
  </div>
  <button type="submit" class="btn btn-primary">Submit</button>
% end
</p>