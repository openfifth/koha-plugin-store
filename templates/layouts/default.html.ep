<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title><%= title %></title>
    <meta name="csrf-token" content="<%= csrf_token %>">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

    <link rel="stylesheet" href="/assets/css/main.css">
    <script src="/assets/js/main.js"></script>
    %= content 'head'
  </head>
  <body>
    <nav class="navbar navbar-default navbar-dark bg-dark">
      <div class="container">
        <div class="navbar-header">
          <a class="navbar-brand" href="/"><img src="/img/koha_128dpi.png" alt="Logo" height="24" class="d-inline-block align-text-top"> <%= app->site_name %></a>
        </div>
        <div class="navbar-header float-right text-white">
        % if ( logged_in_user ) {
          <div class="dropdown">
            <a href="#" role="button" id="account-menu-toggle" data-bs-toggle="dropdown" aria-expanded="false" class="link-underline link-underline-opacity-0 text-white dropdown-toggle">
              <i class='bx bx-user'></i> <%= logged_in_user->username %>
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="account-menu-toggle">
              <li><a class="dropdown-item" href="/my-plugins"><i class='bx bx-list-ol'></i> My Plugins</a></li>
              <li><a class="dropdown-item" href="/profile"><i class='bx bx-id-card'></i> Profile</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item text-danger" href="/logout"><i class='bx bx-log-out'></i> Log Out</a></li>
            </ul>
          </div>
        % } else {
          %= link_to '/login' => (class => 'link-underline link-underline-opacity-0 text-white') => begin
            <i class='bx bx-log-in'></i> Developer login
          % end
        % }
        </div>
      </div>
    </nav>

    <div class="container">
    % if (content('sidebar') ne '') {
      <div class="row">
        <div id="sidebar" class="col-md-3 mt-4">
          %= content 'sidebar'
        </div>
        <div id="main" class="col-md-9 mt-4">
          %= content
        </div>
      </div>
    % } else {
      <div id="main" class="mt-4">
        %= content
      </div>
    % }
    </div>
    %= include 'partial/footer'
    %= content 'end'
    <div id="overlay">
      <div class="cv-spinner">
        <span class="spinner"></span>
      </div>
    </div>
  </body>
</html>
