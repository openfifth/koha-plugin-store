% title 'Developer login';
% layout 'default';

% content_for 'sidebar' => begin
  %= include 'partial/side_menu'
% end

<h2><%= title %></h2>
<p class="text-muted">Only plugin developers need to log in here -- browsing and installing plugins doesn't require an account.</p>

<p>
  %= link_to '/auth/github' => (class => 'btn btn-dark') => begin
    <i class='bx bxl-github'></i> Log in with GitHub
  % end
</p>
