% title "My Plugins";
% layout 'default';

<div class="d-flex align-items-center mb-4">
  % if (logged_in_user->avatar_url) {
  <img src="<%= logged_in_user->avatar_url %>" alt="" class="rounded-circle me-3" width="64" height="64">
  % }
  <h2 class="mb-0">Welcome back, <%= logged_in_user->username %></h2>
</div>

<div class="list-group mb-4">
  %= link_to '/new-plugin' => (class => 'list-group-item list-group-item-action') => begin
    <i class='bx bx-plus'></i> Submit a new plugin
  % end
  %= link_to '/new-plugin/bulk' => (class => 'list-group-item list-group-item-action') => begin
    <i class='bx bx-list-plus'></i> Bulk submit plugins
  % end
</div>

<h2><%= title %></h2>
% if(scalar @{$my_plugins}){
%= include 'partial/table/plugins', plugins => $my_plugins;
% } else{
  <p>You don't have any plugins yet!</p>
  <a href="new-plugin">Submit your first plugin here</a>
% }
