% my %status_badge = (
%   submitted          => 'bg-secondary',
%   checks_running     => 'bg-info',
%   published          => 'bg-success',
%   changes_requested  => 'bg-danger',
%   check_error        => 'bg-warning',
% );
<table class="table">
  <thead>
    <tr>
      <th>ID</th>
      <th>Title</th>
      <th>Description</th>
      <th>Author</th>
      <th>Developer ID</th>
      <th>Releases</th>
      <th>Status</th>
      <th>Actions</th>
    </td>
  </thead>
  <tbody>
    % for my $plugin (@{ $plugins }) {
    % my $latest = $plugin->latest_version;
    <tr>
      %= t td => $plugin->id
      <td>
        %= link_to $plugin->name => '/plugins/'.$plugin->slug
        % if ($plugin->is_private) {
        <span class="badge bg-secondary">Private</span>
        % }
      </td>
      %= t td => $plugin->description
      %= t td => $plugin->author
      %= t td => $plugin->developer_id
      %= t td => scalar @{$plugin->releases}
      <td class="plugin-status">
        % if ($latest) {
        <span class="badge <%= $status_badge{$latest->status} || 'bg-secondary' %>"><%= $latest->status %></span>
        % } else {
        -
        % }
      </td>
    </tr>
  % }
  </tbody>
</table>

