  <div>
    <ul class="list-group">
      %= link_to '/' => (class => 'list-group-item list-group-item-action ' . (current_route eq '' ? 'active' : '' )) => begin
        <i class='bx bx-list-ul'></i> Browse Plugins
      % end
      %= link_to '/developers' => (class => 'list-group-item list-group-item-action ' . (current_route eq 'developers' ? 'active' : '' )) => begin
        <i class='bx bx-code-alt'></i> Plugin developers
      % end
      %= link_to '/verification-key' => (class => 'list-group-item list-group-item-action ' . (current_route eq 'verification-key' ? 'active' : '' )) => begin
        <i class='bx bx-key'></i> Verification key
      % end
    </ul>
  </div>
