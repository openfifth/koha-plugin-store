# koha-plugin-store-worker.service
[Unit]
Description=Koha Plugin Store Minion Worker
After=syslog.target network.target koha-plugin-store.service

[Service]
Type=simple
## make sure the user & group exist
User=plugin-store
Group=plugin-store
## change the below values to suit your installation
## Must be local/lib/perl5, not lib/ -- this is where Perl::Critic/Koha::QA
## get installed (see the cpanfile comment); loading KohaPluginStore at all
## transitively requires Koha::QA::PerlCritic to be on @INC.
Environment=PERL5LIB=/opt/plugin-store/local/lib/perl5
## Path to the syntax-sandbox broker's socket (see
## koha-plugin-store-sandbox-broker.service.example) -- this user must be a
## supplementary member of that unit's group to reach it.
Environment=SANDBOX_BROKER_SOCKET=/run/koha-plugin-store/broker.sock
WorkingDirectory=/opt/plugin-store
## end of config values
ExecStart=/usr/bin/perl script/koha_plugin_store minion worker
KillMode=mixed
Restart=on-failure
RestartSec=5s
SyslogIdentifier=koha-plugin-store-worker

[Install]
WantedBy=multi-user.target
