{
  # GitHub token used for the store's own background API calls (fetching release info,
  # downloading .kpz assets, fetching contributors) -- NOT the developer's own login
  # token. Must be a fine-grained personal access token scoped to "Public Repositories
  # (read-only)" access only: https://github.com/settings/personal-access-tokens/new
  # This constrained scope is deliberate -- it doubles as confirmation that an anonymous
  # Koha library (with no GitHub credentials at all) will be able to fetch the same URLs.
  github_app_token => "YOUR_TOKEN_HERE",

  # Path to the PEM file holding the store's Ed25519 signing private key.
  # Generate one with: script/koha_plugin_store generate_signing_key <path>
  signing_key_path => '/path/to/signing_key.pem',

  # Postgres connection string
  pg_dsn => 'postgresql://koha_plugin_store:koha_plugin_store@127.0.0.1:55432/koha_plugin_store',

  # Optional: an explicit, rotatable secret used to sign session cookies.
  # Without this, Mojolicious auto-generates one per process -- fine for dev,
  # but a restart invalidates every session, and it's not something you
  # control or rotate. Recommended for production. Generate with e.g.:
  #   perl -MMojo::Util=b64_encode -e 'print b64_encode(pack("Q*", map { rand(2**64) } 1..4))'
  # secrets => ['YOUR_RANDOM_SECRET_HERE'],

  # Optional: redirect requests arriving under any other Host to this one
  # (same path and query), e.g. while migrating from an old hostname that's
  # still served by the same cert. Leave unset to serve every Host as-is.
  # canonical_host => 'plugins.koha-community.org',

  # OAuth providers for developer login. 'github' is a built-in provider name
  # recognised by Mojolicious::Plugin::OAuth2 -- register an OAuth App at
  # https://github.com/settings/developers to get a client_id/client_secret.
  oauth_providers => [
    {
      key           => 'github',
      kind          => 'github',
      display_name  => 'GitHub',
      client_id     => 'YOUR_CLIENT_ID',
      client_secret => 'YOUR_CLIENT_SECRET',
    },
  ],
};